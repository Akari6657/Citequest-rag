# CiteQuest-RAG LLM Configuration
# Copy this file to .env and fill in your API key.
# .env is git-ignored — do NOT commit your real key.

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash

# Retrieval runtime default (explicit API request values take precedence)
CITEQUEST_HYBRID_ALPHA=0.5

# Chinese keyword rewrite timeout; official DeepSeek uses non-thinking mode
CITEQUEST_REWRITE_TIMEOUT_SECONDS=2.0

# Whole-chunk evidence budget (default top 5); prompts/output need extra tokens
CITEQUEST_RAG_CONTEXT_TOKENS=8000
